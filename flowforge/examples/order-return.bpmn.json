{
  "schema_version": 1,
  "diagram_type": "bpmn",
  "meta": {
    "title": "Order & Return Process",
    "subtitle": "Place an order, receive goods, raise and resolve a return",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "order-path",
        "label": "Order to delivery",
        "focus": [
          "order",
          "fulfill",
          "ship",
          "receive"
        ],
        "note": "Follow an order from placement through delivery."
      },
      {
        "id": "return-path",
        "label": "Return to refund",
        "focus": [
          "returnreq",
          "review"
        ],
        "note": "Follow a raised return through review and refund."
      }
    ],
    "output": "examples/order-return.bpmn-rendered.html"
  },
  "lanes": [
    {
      "id": "customer",
      "label": "Customer"
    },
    {
      "id": "warehouse",
      "label": "Warehouse"
    },
    {
      "id": "finance",
      "label": "Finance"
    }
  ],
  "phases": [
    {
      "id": "order",
      "label": "Order",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "fulfill",
      "label": "Fulfill",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "aftercare",
      "label": "Return & refund",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "order",
    "fulfill",
    "ship",
    "receive"
  ],
  "nodes": [
    {
      "id": "order",
      "lane": "customer",
      "col": 0,
      "type": "frontend",
      "label": "Place order",
      "sublabel": "cart + payment"
    },
    {
      "id": "fulfill",
      "lane": "warehouse",
      "col": 1,
      "type": "backend",
      "label": "Fulfill order",
      "sublabel": "pick + pack"
    },
    {
      "id": "ship",
      "lane": "warehouse",
      "col": 3,
      "type": "messagebus",
      "label": "Ship order",
      "sublabel": "carrier handoff"
    },
    {
      "id": "receive",
      "lane": "customer",
      "col": 3,
      "type": "frontend",
      "label": "Receive goods",
      "sublabel": "inspect delivery"
    },
    {
      "id": "returnreq",
      "lane": "customer",
      "col": 5,
      "type": "security",
      "label": "Raise return",
      "sublabel": "reason + photos"
    },
    {
      "id": "review",
      "lane": "finance",
      "col": 5,
      "type": "backend",
      "label": "Refund",
      "sublabel": "review + reverse"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "order",
      "to": "fulfill",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "e2",
      "from": "fulfill",
      "to": "ship",
      "variant": "default"
    },
    {
      "id": "e3",
      "from": "ship",
      "to": "receive",
      "label": "delivered",
      "variant": "emphasis",
      "fromSide": "left",
      "toSide": "left",
      "route": "return-left",
      "width": 1.2
    },
    {
      "id": "e4",
      "from": "receive",
      "to": "returnreq",
      "variant": "dashed"
    },
    {
      "id": "e5",
      "from": "returnreq",
      "to": "review",
      "label": "return",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop",
      "labelSegment": 0
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Process Rules",
      "items": [
        "One order path and one return path",
        "Every cross-lane handoff names its mechanism",
        "Refund is a finance-owned outcome"
      ]
    },
    {
      "dot": "rose",
      "title": "Controls",
      "items": [
        "Return review is a policy gate",
        "Delivery and return are separate customer actions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why It Matters",
      "items": [
        "Auditors can follow goods and money separately",
        "The map regenerates when the process changes"
      ]
    }
  ]
}